# OpenAI (trial_matching / criteria parser)
OPENAI_API_KEY=your-openai-key-here
CLASSIFY_MODEL=gpt-4o
EXPAND_MODEL=gpt-4o

# Neo4j (patient matching + node expansion)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=yourpassword

# MySQL (match results storage + PIR visualization)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=yourpassword
MYSQL_DB=operation_v1

# External trial criteria extractor (for NCT ID flow)
EXTRACTOR_API_URL=https://your-extractor-api.example.com/clinicaltrails
